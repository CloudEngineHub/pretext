{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Node's own resolution, so an import in src/ without its .js extension is an error here and not in a consumer.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": false,
    "types": [],
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/layout.test.ts", "src/test-data.ts"]
}
