{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "types": ["bun", "node"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    // Unreachable code is tsc's to find: oxlint 1.51's no-unreachable reports every statement of a labelled loop
    // that a nested endless loop leaves only by a break or continue to that label, as Gecko's line iterator does.
    "allowUnreachableCode": false,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": ["*.ts", "harness/**/*.ts", "pages/**/*.ts", "scripts/**/*.ts", "src/**/*.ts"]
}
